# 环境变量与密钥（数据库/Redis 密码等敏感信息不入库）
.env
.env.*
!.env.example

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log

# 后端构建产物（springboot/.gitignore 另有细分规则）
target/

# 前端依赖与构建产物
node_modules/
dist/

# pnpm 缓存/存储（沙箱重定向产生的本地缓存，不入库）
.pnpm-store/
.localappdata/
.appdata/
.npm-cache/
.pnpm/

# IDE 通用
.idea/
*.iml

# 规划工作文件（本地保留，不入库）
task_plan.md
findings.md
progress.md
